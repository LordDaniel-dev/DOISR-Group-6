#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/doisr/Group6#hasCategory
:hasCategory rdf:type owl:ObjectProperty ;
             rdfs:domain :Nomination ;
             rdfs:range :AwardCategory ;
             rdfs:label "has category"@en .


###  https://w3id.org/doisr/Group6#hasCeremony
:hasCeremony rdf:type owl:ObjectProperty ;
             owl:inverseOf :hasNomination ;
             rdfs:domain :Nomination ;
             rdfs:range :Ceremony ;
             rdfs:label "has ceremony"@en .


###  https://w3id.org/doisr/Group6#hasGender
:hasGender rdf:type owl:ObjectProperty ;
           rdfs:domain :Participant ;
           rdfs:range :Gender ;
           rdfs:label "has gender"@en .


###  https://w3id.org/doisr/Group6#hasGenre
:hasGenre rdf:type owl:ObjectProperty ;
          rdfs:domain :Movie ;
          rdfs:range :Genre ;
          rdfs:label "has genre"@en .


###  https://w3id.org/doisr/Group6#hasNominatedMovie
:hasNominatedMovie rdf:type owl:ObjectProperty ;
                   rdfs:domain :Nomination ;
                   rdfs:range :Movie ;
                   rdfs:label "has nominated movie"@en .


###  https://w3id.org/doisr/Group6#hasNominatedParticipant
:hasNominatedParticipant rdf:type owl:ObjectProperty ;
                         owl:inverseOf :hasNominationParticipant ;
                         rdfs:domain :Nomination ;
                         rdfs:range :Participant ;
                         rdfs:label "has nominated participant"@en .


###  https://w3id.org/doisr/Group6#hasNomination
:hasNomination rdf:type owl:ObjectProperty ;
               rdfs:domain :Ceremony ;
               rdfs:range :Nomination ;
               rdfs:label "has nomination"@en .


###  https://w3id.org/doisr/Group6#hasNominationParticipant
:hasNominationParticipant rdf:type owl:ObjectProperty ;
                          rdfs:domain :Participant ;
                          rdfs:range :Nomination ;
                          rdfs:label "has nomination participant"@en .


###  https://w3id.org/doisr/Group6#hasParticipant
:hasParticipant rdf:type owl:ObjectProperty ;
                rdfs:domain :Participation ;
                rdfs:range :Participant ;
                rdfs:label "has participant"@en .


###  https://w3id.org/doisr/Group6#hasRating
:hasRating rdf:type owl:ObjectProperty ;
           owl:inverseOf :isRating ;
           rdfs:domain :Movie ;
           rdfs:range :Rating ;
           rdfs:label "has rating"@en .


###  https://w3id.org/doisr/Group6#hasRole
:hasRole rdf:type owl:ObjectProperty ;
         rdfs:domain :Participation ;
         rdfs:range :Role ;
         rdfs:label "has role"@en .


###  https://w3id.org/doisr/Group6#isRating
:isRating rdf:type owl:ObjectProperty ;
          rdfs:domain :Rating ;
          rdfs:range :Movie ;
          rdfs:label "is rating"@en .


###  https://w3id.org/doisr/Group6#participatesIn
:participatesIn rdf:type owl:ObjectProperty ;
                rdfs:domain :Participation ;
                rdfs:range :Movie ;
                rdfs:label "participates in"@en .



#################################################################

###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :Movie ;
                                 rdfs:range xsd:string ;
                                 rdfs:label "title"@en .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :Participant ;
                                 rdfs:range xsd:string ;
                                 rdfs:label "name"@en .


###  https://w3id.org/doisr/Group6#hasActorCredits
:hasActorCredits rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Participant ;
                 rdfs:range xsd:boolean ;
                 rdfs:label "has actor credits"@en .


###  https://w3id.org/doisr/Group6#hasActressCredits
:hasActressCredits rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Participant ;
                   rdfs:range xsd:boolean ;
                   rdfs:label "has actress credits"@en .


###  https://w3id.org/doisr/Group6#hasBudget
:hasBudget rdf:type owl:DatatypeProperty ;
           rdfs:domain :Movie ;
           rdfs:range xsd:decimal ;
           rdfs:label "has budget"@en .


###  https://w3id.org/doisr/Group6#hasCeremonyNumber
:hasCeremonyNumber rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Ceremony ;
                   rdfs:range xsd:integer ;
                   rdfs:label "has ceremony number"@en .


###  https://w3id.org/doisr/Group6#hasFemaleCount
:hasFemaleCount rdf:type owl:DatatypeProperty ;
                rdfs:domain :Participant ;
                rdfs:range xsd:integer ;
                rdfs:label "has female count"@en .


###  https://w3id.org/doisr/Group6#hasGenderPercent
:hasGenderPercent rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Movie ;
                  rdfs:range xsd:integer ;
                  rdfs:label "has gender percent"@en .


###  https://w3id.org/doisr/Group6#hasId
:hasId rdf:type owl:DatatypeProperty ;
       rdfs:domain :Participant ;
       rdfs:range xsd:integer ;
       rdfs:label "has id"@en .


###  https://w3id.org/doisr/Group6#hasMaleCount
:hasMaleCount rdf:type owl:DatatypeProperty ;
              rdfs:domain :Participant ;
              rdfs:range xsd:integer ;
              rdfs:label "has male count"@en .


###  https://w3id.org/doisr/Group6#hasNumVotes
:hasNumVotes rdf:type owl:DatatypeProperty ;
             rdfs:domain :Rating ;
             rdfs:range xsd:integer ;
             rdfs:label "has num votes"@en .


###  https://w3id.org/doisr/Group6#hasRatingValue
:hasRatingValue rdf:type owl:DatatypeProperty ;
                rdfs:domain :Rating ;
                rdfs:range xsd:decimal ;
                rdfs:label "has rating value"@en .


###  https://w3id.org/doisr/Group6#hasReleaseYear
:hasReleaseYear rdf:type owl:DatatypeProperty ;
                rdfs:domain :Movie ;
                rdfs:range xsd:gYear ;
                rdfs:label "has release year"@en .


###  https://w3id.org/doisr/Group6#hasYearCelebrated
:hasYearCelebrated rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Ceremony ;
                   rdfs:range xsd:gYear ;
                   rdfs:label "has year celebrated"@en .


###  https://w3id.org/doisr/Group6#isWinner
:isWinner rdf:type owl:DatatypeProperty ;
          rdfs:domain :Nomination ;
          rdfs:range xsd:boolean ;
          rdfs:label "is winner"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://schema.org/Event
<https://schema.org/Event> rdf:type owl:Class .


###  https://schema.org/Movie
<https://schema.org/Movie> rdf:type owl:Class .


###  https://schema.org/Rating
<https://schema.org/Rating> rdf:type owl:Class .


###  https://w3id.org/doisr/Group6#AwardCategory
:AwardCategory rdf:type owl:Class ;
               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
               rdfs:label "Award Category"@en .


###  https://w3id.org/doisr/Group6#Ceremony
:Ceremony rdf:type owl:Class ;
          rdfs:subClassOf <https://schema.org/Event> ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasNomination ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Nomination
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasCeremonyNumber ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:integer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasYearCelebrated ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:gYear
                          ] ;
          rdfs:label "Ceremony"@en .


###  https://w3id.org/doisr/Group6#Gender
:Gender rdf:type owl:Class ;
        rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
        rdfs:label "Gender"@en .


###  https://w3id.org/doisr/Group6#Genre
:Genre rdf:type owl:Class ;
       rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
       rdfs:label "Genre"@en .


###  https://w3id.org/doisr/Group6#Movie
:Movie rdf:type owl:Class ;
       rdfs:subClassOf <https://schema.org/Movie> ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty <http://purl.org/dc/terms/title> ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasBudget ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:decimal
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasGenderPercent ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:integer
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasReleaseYear ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:gYear
                       ] ;
       rdfs:label "Movie"@en .


###  https://w3id.org/doisr/Group6#Nomination
:Nomination rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :hasCategory ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :AwardCategory
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasCeremony ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Ceremony
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasNominatedMovie ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Movie
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasNominatedParticipant ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Participant
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :isWinner ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:boolean
                            ] ;
            rdfs:label "Nomination"@en .


###  https://w3id.org/doisr/Group6#Participant
:Participant rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty <http://xmlns.com/foaf/0.1/name> ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasId ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:integer
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasActorCredits ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:boolean
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasActressCredits ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:boolean
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasFemaleCount ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:integer
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasMaleCount ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:integer
                             ] ;
             rdfs:label "Participant"@en .


###  https://w3id.org/doisr/Group6#Participation
:Participation rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasRole ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Role
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasParticipant ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Participant
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :participatesIn ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Movie
                               ] ;
               rdfs:label "Participation"@en .


###  https://w3id.org/doisr/Group6#Rating
:Rating rdf:type owl:Class ;
        rdfs:subClassOf <https://schema.org/Rating> ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isRating ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Movie
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasNumVotes ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:integer
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasRatingValue ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:decimal
                        ] ;
        rdfs:label "Rating"@en .


###  https://w3id.org/doisr/Group6#Role
:Role rdf:type owl:Class ;
      rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
      rdfs:label "Role"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/doisr/Group6
<https://w3id.org/doisr/Group6> rdf:type owl:NamedIndividual ;
                                <http://purl.org/dc/terms/title> "IMDb Movie Ontology"@en .


###  https://w3id.org/doisr/Group6#Actor
:Actor rdf:type owl:NamedIndividual ,
                <http://www.w3.org/2004/02/skos/core#Concept> ;
       rdfs:label "Actor"@en ;
       <http://www.w3.org/2004/02/skos/core#inScheme> :Role .


###  https://w3id.org/doisr/Group6#Director
:Director rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#Concept> ;
          rdfs:label "Director"@en ;
          <http://www.w3.org/2004/02/skos/core#inScheme> :Role .


###  https://w3id.org/doisr/Group6#Producer
:Producer rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#Concept> ;
          rdfs:label "Producer"@en ;
          <http://www.w3.org/2004/02/skos/core#inScheme> :Role .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AwardCategory
                :Gender
                :Genre
                :Role
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Ceremony
                :Movie
                :Nomination
                :Participant
                :Participation
                :Rating
              )
] .


